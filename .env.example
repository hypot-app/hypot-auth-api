# Local development values. Copy to .env and adjust; never commit .env.
# Load it with: node --env-file=.env dist/main.js
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hypot:hypot_dev_only@localhost:5432/hypot

# Public URL of this service, used to build links in emails. No trailing slash.
AUTH_PUBLIC_BASE_URL=http://localhost:3000

# Mailpit (docker compose) catches all outgoing mail: UI at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER and SMTP_PASS must be set together, or both omitted.
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=no-reply@hypot.local

# Token signing keys (RS256 JWK set). Generate a dev-only set with: npm run keys:generate
# That writes .keys/signing-keys.json (gitignored). Set exactly one of the two variables.
AUTH_SIGNING_KEYS_FILE=.keys/signing-keys.json
# AUTH_SIGNING_KEYS={"active":{...},"next":{...}}
