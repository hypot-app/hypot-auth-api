{
  "name": "hypot",
  "version": "0.0.1",
  "private": true,
  "description": "Centralized multi-app authentication service",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node scripts/dev.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "test": "jest",
    "test:unit": "jest --testPathPatterns \"\\.spec\\.ts$\"",
    "test:e2e": "jest --testPathPatterns \"\\.e2e-spec\\.ts$\"",
    "test:integration": "jest --testPathPatterns \"\\.int-spec\\.ts$\"",
    "typecheck": "tsc --noEmit",
    "migration:generate": "npm run build && node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:generate -d dist/platform/persistence/data-source.js",
    "migration:create": "typeorm migration:create",
    "migration:run": "npm run build && node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:run -d dist/platform/persistence/data-source.js",
    "migration:revert": "npm run build && node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:revert -d dist/platform/persistence/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt": "^6.0.0",
    "handlebars": "^4.7.9",
    "nest-commander": "^3.21.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
